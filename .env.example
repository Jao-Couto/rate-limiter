# Host ports
SERVER_PORT=4000
GATEWAY_1_PORT=3001
GATEWAY_2_PORT=3002
GATEWAY_3_PORT=3003
ZOOKEEPER_PORT=2181

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting: fail "closed" (reject on Redis outage) or "open" (let through)
FAIL_MODE=closed
DEFAULT_BUCKET_CAPACITY=10
DEFAULT_REFILL_PER_SEC=5
ZK_RULES_PATH=/rate-limiter/rules

# Load generator (docker compose --profile load up client)
TARGET_PATH=/api/resource
CLIENT_IDS=alice,bob,carol
RPS=30
DURATION_SEC=15
